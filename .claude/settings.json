{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets.*)",
      "Read(**/secret.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/credentials.*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/.ssh/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "smart-commit",
        "hooks": [
          {
            "type": "command",
            "command": "bun test",
            "statusMessage": "테스트 실행 중...",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/check-test.ps1",
            "statusMessage": "테스트 파일 확인 중...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
